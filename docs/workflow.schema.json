{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TapDone workflow definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "nodes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "kind": {
            "enum": [
              "task",
              "review"
            ]
          },
          "taskID": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "dependsOn": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 128,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            }
          },
          "inputBindings": {
            "type": "object",
            "maxProperties": 128,
            "propertyNames": {
              "minLength": 1,
              "maxLength": 256
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "nodeID"
              ],
              "properties": {
                "nodeID": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                },
                "path": {
                  "type": "array",
                  "maxItems": 12,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "task"
                }
              }
            },
            "then": {
              "required": [
                "taskID"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "review"
                }
              }
            },
            "then": {
              "required": [
                "dependsOn"
              ],
              "properties": {
                "dependsOn": {
                  "minItems": 1
                },
                "inputBindings": {
                  "maxProperties": 0
                }
              },
              "not": {
                "required": [
                  "taskID"
                ]
              }
            }
          }
        ]
      }
    }
  }
}
