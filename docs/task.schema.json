{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TapDone task or batch",
  "oneOf": [
    {
      "$ref": "#/$defs/task"
    },
    {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  ],
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "category",
        "name",
        "action"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "showInDock": {
          "type": "boolean"
        },
        "action": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "bundleIdentifier"
              ],
              "properties": {
                "type": {
                  "const": "application"
                },
                "bundleIdentifier": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]+$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "url"
              ],
              "properties": {
                "type": {
                  "const": "website"
                },
                "url": {
                  "type": "string",
                  "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://",
                  "format": "uri"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "path"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "open",
                    "folder",
                    "file"
                  ]
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "command",
                "workingDirectory"
              ],
              "properties": {
                "type": {
                  "const": "command"
                },
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "workingDirectory": {
                  "type": "string",
                  "minLength": 1
                },
                "timeoutSeconds": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 86400,
                  "default": 300
                },
                "environment": {
                  "type": "object",
                  "propertyNames": {
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "executable",
                "workingDirectory"
              ],
              "properties": {
                "type": {
                  "const": "external"
                },
                "executable": {
                  "type": "string",
                  "minLength": 1
                },
                "arguments": {
                  "type": "array",
                  "maxItems": 4096,
                  "items": {
                    "type": "string"
                  }
                },
                "input": {},
                "workingDirectory": {
                  "type": "string",
                  "minLength": 1
                },
                "timeoutSeconds": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 86400,
                  "default": 300
                },
                "environment": {
                  "type": "object",
                  "propertyNames": {
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "protocolVersion": {
                  "type": "integer",
                  "enum": [
                    1,
                    2
                  ],
                  "default": 1
                },
                "inputContract": {
                  "$ref": "#/$defs/payloadContract"
                },
                "outputContract": {
                  "$ref": "#/$defs/payloadContract"
                },
                "asyncOptions": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "pollIntervalSeconds": {
                      "type": "number",
                      "minimum": 2,
                      "maximum": 300,
                      "default": 5
                    },
                    "timeoutSeconds": {
                      "type": "number",
                      "minimum": 1,
                      "maximum": 86400,
                      "default": 3600
                    }
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "required": [
                      "asyncOptions"
                    ]
                  },
                  "then": {
                    "required": [
                      "protocolVersion"
                    ],
                    "properties": {
                      "protocolVersion": {
                        "const": 2
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "iconAssetID": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "activityTitle": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            },
            "activityEnabled": {
              "type": "boolean"
            },
            "useSymbol": {
              "type": "boolean",
              "description": "Prefer the configured SF Symbol over the native application/file icon. Imported image takes precedence."
            },
            "builtinIconID": {
              "type": "string",
              "enum": [
                "zap",
                "star",
                "heart",
                "flag",
                "bookmark",
                "bell",
                "clock",
                "circle-check",
                "terminal",
                "code",
                "braces",
                "bug",
                "hammer",
                "git-branch",
                "package",
                "workflow",
                "folder",
                "folder-open",
                "file",
                "file-text",
                "archive",
                "clipboard",
                "download",
                "upload",
                "globe",
                "link",
                "server",
                "database",
                "cloud",
                "wifi",
                "network",
                "send",
                "settings",
                "wrench",
                "search",
                "monitor",
                "camera",
                "image",
                "scissors",
                "lock",
                "play",
                "pause",
                "refresh-cw",
                "calendar",
                "list-checks",
                "chart-column",
                "rocket",
                "coffee"
              ]
            }
          }
        }
      }
    },
    "payloadContract": {
      "description": "TapDone bounded contract subset; depth <=12 and encoded size <=64 KB are enforced by runtime.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "object"
            },
            "properties": {
              "type": "object",
              "maxProperties": 128,
              "propertyNames": {
                "minLength": 1,
                "maxLength": 256
              },
              "additionalProperties": {
                "$ref": "#/$defs/payloadContract"
              }
            },
            "required": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "additionalProperties": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "items"
          ],
          "properties": {
            "type": {
              "const": "array"
            },
            "items": {
              "$ref": "#/$defs/payloadContract"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "string"
            },
            "minLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1048576
            },
            "maxLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1048576
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "number"
            },
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "integer"
            },
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "null"
            }
          }
        }
      ]
    }
  }
}
