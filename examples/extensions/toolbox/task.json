{
  "schemaVersion": 1,
  "id": "extensions.toolbox",
  "category": "外部扩展",
  "name": "系统信息（扩展示例）",
  "icon": "gearshape",
  "showInDock": false,
  "action": {
    "type": "external",
    "executable": "/usr/bin/python3",
    "arguments": [
      "main.py"
    ],
    "workingDirectory": "~/Library/Application Support/SideTap/scripts/toolbox",
    "timeoutSeconds": 30,
    "input": {
      "operation": "system-info"
    }
  }
}
